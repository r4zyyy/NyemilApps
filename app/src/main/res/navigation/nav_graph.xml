<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Screen 1: Splash / Welcome -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="lat.pam.droidcafe.ui.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_signUpEntryFragment"
            app:destination="@id/signUpEntryFragment" />
    </fragment>

    <!-- Screen 2: Sign Up Entry -->
    <fragment
        android:id="@+id/signUpEntryFragment"
        android:name="lat.pam.droidcafe.ui.SignUpEntryFragment"
        android:label="Sign Up Entry"
        tools:layout="@layout/fragment_sign_up_entry">
        <action
            android:id="@+id/action_signUpEntryFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_signUpEntryFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <!-- Screen 3: Login User -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="lat.pam.droidcafe.ui.LoginFragment"
        android:label="Login User"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Screen 4: Register -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="lat.pam.droidcafe.ui.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <!-- Screen 5: Home -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="lat.pam.droidcafe.ui.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_addressFragment"
            app:destination="@id/addressFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <!-- Screen 6: Profile -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="lat.pam.droidcafe.ui.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_profileFragment_to_addressFragment"
            app:destination="@id/addressFragment" />
    </fragment>

    <!-- Screen 7: Alamat pengiriman (Order) -->
    <fragment
        android:id="@+id/addressFragment"
        android:name="lat.pam.droidcafe.ui.AddressFragment"
        android:label="Alamat Pengiriman"
        tools:layout="@layout/fragment_address">
        <action
            android:id="@+id/action_addressFragment_to_confirmationFragment"
            app:destination="@id/confirmationFragment" />
    </fragment>

    <!-- Screen 8: Konfirmasi pesanan -->
    <fragment
        android:id="@+id/confirmationFragment"
        android:name="lat.pam.droidcafe.ui.ConfirmationFragment"
        android:label="Konfirmasi Pesanan"
        tools:layout="@layout/fragment_confirmation">
        <action
            android:id="@+id/action_confirmationFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>